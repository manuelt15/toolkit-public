{
  "name": "@manuelt15/toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Flujo para empezar proyectos con agentes de IA: módulos, skills y sesiones con cierre.",
  "license": "MIT",
  "author": "manuelt15 (https://github.com/manuelt15)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelt15/toolkit-public.git"
  },
  "type": "module",
  "bin": {
    "tk": "bin/tk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin/",
    "src/",
    "catalogo/",
    "modulos/",
    "arquitecturas/",
    "plantillas/",
    "assets/"
  ],
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "scripts/audit.sh",
    "prepublishOnly": "echo \"Publicación bloqueada hasta F6 (audit y ok del mantenedor)\" && exit 1"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
